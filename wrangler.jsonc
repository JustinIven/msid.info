{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "msid-info",
	"main": "build/worker/shim.mjs",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"build": {
		"command": "cargo install -q worker-build --version 0.8.6 && worker-build --release"
	},
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"vars": {
		"TURNSTILE_SITEKEY": "0x4AAAAAAFCSE1kjvQV5Dek7",
		"CACHE_TTL_SECONDS": "900"
	},
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "9e8e08eac6724d1b8aa85f75776b5025"
		}
	],
	"ratelimits": [
		{
			"name": "RL_ANON",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "RL_VERIFIED",
			"namespace_id": "1002",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	]
}